# Local development only. Never commit populated .env files or credentials.
APP_NAME=Relay AI
APP_VERSION=0.4.0
DATABASE_URL=sqlite:///./relay_dev.db

# Set this to enable Gemini-powered features.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-lite-latest

# Exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safe public demo defaults.
RELAY_PUBLIC_DEMO_MODE=true
RELAY_ENABLE_GMAIL_CONNECTOR=false
RELAY_ENABLE_IN_PROCESS_SCHEDULER=false
RELAY_RATE_LIMIT_PER_MINUTE=120
RELAY_AI_RATE_LIMIT_PER_MINUTE=12

# Private Gmail setup only (requires demo mode=false and connector=true).
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/email/gmail/callback
RELAY_TOKEN_ENCRYPTION_KEY=
